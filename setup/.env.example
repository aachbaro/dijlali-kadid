# ============================================================
# .env.example — Variables d'environnement
# Copiez ce fichier en .env et remplissez toutes les valeurs.
# Ne commitez JAMAIS le fichier .env dans Git.
# ============================================================

# ── Base de données (créée dans cPanel > MySQL Databases) ──
DB_NAME=nomcpanel_galerie
DB_USER=nomcpanel_user
DB_PASSWORD=motdepasse_securise
DB_HOST=localhost

# ── URLs du site (sans slash final) ───────────────────────
WP_HOME=https://monsite.fr
WP_SITEURL=https://monsite.fr

# ── Compte administrateur WordPress ───────────────────────
ADMIN_USER=admin_galerie
ADMIN_PASSWORD=motdepasse_admin_tres_securise
ADMIN_EMAIL=votre@email.fr

# ── Titre du site ──────────────────────────────────────────
SITE_TITLE=Galerie [Nom Artiste]

# ── Préfixe des tables (évite le préfixe wp_ par défaut) ──
TABLE_PREFIX=art_

# ── Stripe (récupéré sur dashboard.stripe.com > Développeurs > Clés API) ──
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Emails ────────────────────────────────────────────────
CONTACT_EMAIL=contact@monsite.fr

# SMTP Production (o2switch)
# Creer l'adresse dans cPanel > Comptes de messagerie.
# Le SMTP host o2switch est generalement mail.votredomaine.fr.
SMTP_HOST=mail.monsite.fr
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=contact@monsite.fr
SMTP_PASSWORD=motdepasse_email_cpanel

# ── Debug (false en production, true en développement) ────
WP_DEBUG=false
